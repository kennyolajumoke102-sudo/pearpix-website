{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/pearlpixlite-api/(.*)",
      "destination": "http://169.58.213.109/$1"
    },
    {
      "source": "/munopix-api/(.*)",
      "destination": "http://169.58.213.109/$1"
    },
    {
      "source": "/bujjuko-config-api/(.*)",
      "destination": "http://194.9.62.158/$1"
    },
    {
      "source": "/pearlpix-api/(.*)",
      "destination": "https://api.pearlpix.xyz/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
